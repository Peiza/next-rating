{
  "name": "next-rating",
  "version": "0.1.0",
  "private": true,
  "description": "Unofficial PDGA rating predictor. Not affiliated with the PDGA.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests && tsc --noEmit -p tsconfig.node.json",
    "check:i18n": "node scripts/check-i18n.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "jsdom": "30.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
